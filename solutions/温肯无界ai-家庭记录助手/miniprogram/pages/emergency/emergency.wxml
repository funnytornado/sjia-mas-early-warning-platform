<view class="wrap">
 <view class="notice">这是给医生看的急诊卡。内容只存在本机，作沟通参考用，不构成诊断或用药建议；请由医生判断处置。</view>

 <block wx:if="{{!editing}}">
  <view class="card"><view class="heading">1 · 主要诊断</view><view class="statusline">{{e.diagnosis||'未填写'}}</view><view class="muted topgap">重要既往并发症：{{e.complications||'未填写'}}</view></view>

  <view class="card"><view class="heading">2 · 药物过敏</view><view class="pill {{e.allergyStatus==='known'?'active':''}}">{{statusText}}</view>
   <view wx:if="{{e.allergyStatus==='known'}}"><view class="line" wx:for="{{e.allergies}}" wx:key="index"><view>{{item.drug||'未填药名'}}：{{item.reaction||'未填反应'}}</view></view><view class="muted" wx:if="{{!e.allergies.length}}">选了「有已知过敏」，但还没填药名与反应。</view></view>
   <view class="muted topgap" wx:if="{{e.allergyStatus==='unknown'}}">尚未确认过过敏史，不要当成「没有过敏」。</view>
  </view>

  <view class="card"><view class="heading">3 · 当前用药</view>
   <view class="line" wx:for="{{e.meds}}" wx:key="index"><view>{{item.name||'未填药名'}} {{item.dose}}</view><view class="muted">{{item.frequency}}{{item.lastTaken?'｜最近一次：'+item.lastTaken:''}}</view></view>
   <view class="muted" wx:if="{{!e.meds.length}}">未填写当前用药。</view></view>

  <view class="card"><view class="heading">4 · 体重 / 身高</view><view class="statusline">体重 {{e.weight||'未填'}}</view><view class="muted">测量日期：{{e.weightDate||'未填'}}</view><view class="topgap">身高 {{e.height||'未填'}}</view><view class="muted">测量日期：{{e.heightDate||'未填'}}</view></view>

  <view class="card"><view class="heading">5 · 就诊关系</view><view class="line"><view>长期随诊：{{e.hospital||'未填'}} {{e.department}}</view><view class="muted">本地接诊医院：{{e.localHospital||'未填'}}</view><view class="muted">医生联系方式：{{e.doctorContact||'未填'}}</view></view><view class="muted topgap">只填写已获准用于联系的渠道。</view></view>

  <view class="card"><view class="heading">6 · 专科特别交代</view><view class="sub">医生确认的急诊注意事项，没有就留空。</view><view>{{e.notes||'（留空）'}}</view></view>

  <button bindtap="toggleEdit">编辑</button>
  <button class="secondary" bindtap="back">返回个人页</button>
 </block>

 <block wx:else>
  <view class="card"><view class="heading">1 · 主要诊断</view><view class="label">疾病名称</view><input placeholder="如 全身型幼年特发性关节炎（sJIA）" value="{{e.diagnosis}}" data-key="diagnosis" bindinput="field"/><view class="label">重要既往并发症</view><textarea placeholder="可留空；如 曾有巨噬细胞活化综合征" value="{{e.complications}}" data-key="complications" bindinput="field"/></view>

  <view class="card"><view class="heading">2 · 药物过敏</view><view class="sub">先选状态：「尚不清楚」与「无已知过敏」是两件不同的事，不要把没确认过写成没有。</view><picker mode="selector" range="{{statusOptions}}" bindchange="pickStatus"><view class="pill {{e.allergyStatus==='known'?'active':''}}">{{statusText}}</view></picker>
   <block wx:if="{{e.allergyStatus==='known'}}"><view class="line" wx:for="{{e.allergies}}" wx:key="index"><view class="grid"><input placeholder="药名" value="{{item.drug}}" data-key="allergies[{{index}}].drug" bindinput="field"/><input placeholder="具体反应，如 皮疹 / 呼吸困难" value="{{item.reaction}}" data-key="allergies[{{index}}].reaction" bindinput="field"/></view><view class="danger small" data-index="{{index}}" bindtap="removeAllergy">移除此条</view></view><button class="secondary" bindtap="addAllergy">＋ 添加过敏药</button></block>
  </view>

  <view class="card"><view class="heading">3 · 当前用药</view>
   <view class="line" wx:for="{{e.meds}}" wx:key="index"><view class="grid"><input placeholder="药名" value="{{item.name}}" data-key="meds[{{index}}].name" bindinput="field"/><input placeholder="剂量，如 5 mg" value="{{item.dose}}" data-key="meds[{{index}}].dose" bindinput="field"/><input placeholder="频次，如 每日两次" value="{{item.frequency}}" data-key="meds[{{index}}].frequency" bindinput="field"/><input placeholder="最近一次用药时间，如 2026-10-16 08:00" value="{{item.lastTaken}}" data-key="meds[{{index}}].lastTaken" bindinput="field"/></view><view class="danger small" data-index="{{index}}" bindtap="removeMed">移除此条</view></view>
   <button class="secondary" bindtap="addMed">＋ 添加一条用药</button><button class="secondary" bindtap="importMeds">从用药记录导入「仍在用」的药</button>
   <view class="muted topgap">导入只补不覆盖，剂量与频次按用药记录填写；最近一次用药时间需要你自己填。</view></view>

  <view class="card"><view class="heading">4 · 体重 / 身高</view><view class="label">体重（优先显示）</view><input type="digit" placeholder="如 18.5 kg" value="{{e.weight}}" data-key="weight" bindinput="field"/><view class="label">体重测量日期</view><picker mode="date" value="{{e.weightDate}}" data-key="weightDate" bindchange="field"><view class="pill">{{e.weightDate||'选择日期'}}</view></picker><view class="label">身高</view><input type="digit" placeholder="如 112 cm" value="{{e.height}}" data-key="height" bindinput="field"/><view class="label">身高测量日期</view><picker mode="date" value="{{e.heightDate}}" data-key="heightDate" bindchange="field"><view class="pill">{{e.heightDate||'选择日期'}}</view></picker></view>

  <view class="card"><view class="heading">5 · 就诊关系</view><view class="label">长期随诊医院</view><input placeholder="如 XX 儿童医院" value="{{e.hospital}}" data-key="hospital" bindinput="field"/><view class="label">长期随诊科室</view><input placeholder="如 风湿免疫科" value="{{e.department}}" data-key="department" bindinput="field"/><view class="label">本地接诊医院</view><input placeholder="就近可去的医院" value="{{e.localHospital}}" data-key="localHospital" bindinput="field"/><view class="label">医生联系方式</view><input placeholder="只填已获准用于联系的渠道" value="{{e.doctorContact}}" data-key="doctorContact" bindinput="field"/><view class="muted topgap">请只填写医生明确同意用于联系的渠道，不要填未经许可公开的私人号码。</view></view>

  <view class="card"><view class="heading">6 · 专科特别交代</view><view class="sub">医生确认的急诊注意事项，没有就留空。</view><textarea placeholder="可留空；如 发热时先联系随诊医生，不要自行加药" value="{{e.notes}}" data-key="notes" bindinput="field"/></view>

  <button bindtap="toggleEdit">完成</button>
 </block>
</view>
