<view class="wrap">
 <view class="notice">这一页是录入区：化验单、用药记录、症状记录。填完直接返回，首页会自动更新。</view>
 <view class="card" wx:if="{{editing==='report'}}"><view class="muted">正在修改一份已有报告，保存后覆盖原记录。</view></view>
 <view class="card" wx:if="{{editing==='medication'}}"><view class="muted">正在修改一段用药记录。</view></view>
 <view class="card" wx:if="{{editing==='symptom'}}"><view class="muted">正在修改一条症状记录。</view></view>
 <view class="card"><view class="heading">化验单 · 核对后保存</view><view class="sub">任意检查都可以记录，包括数值与阴性/阳性。保存前请核对项目、日期、单位和参考范围。</view><button bindtap="upload" loading="{{busy}}" disabled="{{busy}}">拍照 / 上传原始报告</button><image wx:if="{{draft.image}}" src="{{draft.image}}" class="report-image" mode="aspectFit" bindtap="previewImage"/><view class="label">报告名称</view><input value="{{draft.title}}" data-path="draft.title" bindinput="field"/><view class="label">采样日期（不是上传日期）</view><picker mode="date" value="{{draft.date}}" data-path="draft.date" bindchange="field"><view class="pill">{{draft.date}}</view></picker>
  <view class="line" wx:for="{{draft.items}}" wx:key="index"><view class="grid"><input placeholder="检查项目，如铁蛋白" value="{{item.name}}" data-path="draft.items[{{index}}].name" bindinput="field"/><input placeholder="结果，如 200 / 阴性" value="{{item.value}}" data-path="draft.items[{{index}}].value" bindinput="field"/><input placeholder="单位，如 ng/mL" value="{{item.unit}}" data-path="draft.items[{{index}}].unit" bindinput="field"/><input placeholder="报告参考范围" value="{{item.reference}}" data-path="draft.items[{{index}}].reference" bindinput="field"/></view><input placeholder="报告异常标记：偏高 / 偏低 / 留空" value="{{item.flag}}" data-path="draft.items[{{index}}].flag" bindinput="field"/><view class="danger small" data-index="{{index}}" bindtap="removeItem">移除此项目</view></view><button class="secondary" bindtap="addItem">＋ 添加检查项目</button><button bindtap="saveReport">已核对，保存报告</button>
 </view>
 <view class="card medication"><view class="heading">用药记录</view><view class="sub">一个药记成一段用药：开始日期必填，结束日期留空表示仍在用。剂量和用法按医生嘱咐或药盒原样填写，本工具不做换算、不做剂量建议。</view><view class="label">药名</view><input placeholder="如 泼尼松 / 甲氨蝶呤" value="{{draftMed.name}}" data-path="draftMed.name" bindinput="field"/><view class="grid"><input placeholder="剂量，如 5 mg" value="{{draftMed.dose}}" data-path="draftMed.dose" bindinput="field"/><input placeholder="用法频次，如 每日一次" value="{{draftMed.frequency}}" data-path="draftMed.frequency" bindinput="field"/></view><view class="label">用药起止</view><view class="row"><picker mode="date" value="{{draftMed.date}}" data-path="draftMed.date" bindchange="field"><view class="pill">开始：{{draftMed.date}}</view></picker><picker mode="date" value="{{draftMed.endDate}}" data-path="draftMed.endDate" bindchange="field"><view class="pill">{{draftMed.endDate?'结束：'+draftMed.endDate:'结束：仍在用'}}</view></picker></view><view class="danger small" wx:if="{{draftMed.endDate}}" bindtap="clearMedEnd">清除结束日期</view><textarea placeholder="备注，如 晨起顿服；按医嘱减量；漏服怎么补" value="{{draftMed.note}}" data-path="draftMed.note" bindinput="field"/><button bindtap="saveMed">{{draftMed.id?'保存用药修改':'保存用药记录'}}</button><button class="secondary" wx:if="{{draftMed.id}}" bindtap="cancelMedEdit">取消修改</button></view>
 <view class="card symptom"><view class="heading">今天的症状与变化</view><picker mode="date" value="{{symptomDate}}" data-path="symptomDate" bindchange="field"><view class="pill">{{symptomDate}}</view></picker><view class="row topgap"><view class="pill" wx:for="{{['发热','皮疹','食欲下降','精神状态变化']}}" wx:key="*this" data-text="{{item}}" bindtap="symptomTag">{{item}} ＋</view></view><textarea placeholder="例如：晚间发热，食欲下降；可补充体温、时间等" value="{{symptomText}}" data-path="symptomText" bindinput="field"/><button bindtap="saveSymptom">保存症状记录</button></view>
 <button class="secondary" bindtap="back">返回记录页</button>
</view>
