<view class="wrap">
 <view class="hero"><view class="muted">家庭记录助手</view><view class="title">发现</view><view class="sub">就医资源 · 政策资讯</view><view class="pill topgap">演示页面 · 不含真实信息</view></view>
 <view class="notice topgap">{{pageNote}}</view>
 <view class="subnav"><view wx:for="{{sections}}" wx:key="id" class="tab {{section===item.id?'active':''}}" hover-class="tap" data-section="{{item.id}}" bindtap="switchSection">{{item.label}}</view></view>
 <block wx:if="{{section==='resources'}}">
  <view class="tabpane">
  <view class="card"><view class="heading">就医资源</view><view class="sub">按城市与科室筛样例医院卡片。距离、官方科室介绍与预约入口都需要外部数据源，这里只展示形态。</view>
   <input placeholder="搜索：医院名 / 城市 / 科室 / 地址" value="{{kwH}}" data-which="kwH" bindinput="inputKw" confirm-type="search"/>
   <view class="muted topgap">共 {{hospitals.length}} 张卡片{{kwH?'（关键词：'+kwH+'）':''}}</view>
   <view class="row topgap" wx:if="{{kwH}}"><view class="pill" data-which="kwH" bindtap="clearKw">清除「{{kwH}}」</view></view><view class="filter"><view wx:for="{{cities}}" wx:key="*this" class="pill {{activeCity===item?'active':''}}" data-value="{{item}}" bindtap="pickCity">{{item}}</view></view><view class="filter"><view wx:for="{{departments}}" wx:key="*this" class="pill {{activeDept===item?'active':''}}" data-value="{{item}}" bindtap="pickDept">{{item}}</view></view></view>
  <view class="card" wx:for="{{hospitals}}" wx:key="id"><view class="post-title">{{item.name}}</view><view class="muted">{{item.city}} · {{item.level}} · {{item.departments}}<text class="badge">{{demoNote}}</text></view><view class="sub topgap">{{item.address}}</view><view class="sub">官方入口：{{item.officialSite}}｜{{item.appointment}}</view><view class="row topgap"><view class="pill" bindtap="demoOnly">查看科室介绍</view><view class="pill" bindtap="demoOnly">预约入口</view><view class="pill" hover-class="tap" data-id="{{item.id}}" bindtap="openPolicy">相关政策</view><view class="pill" bindtap="demoOnly">复制地址</view></view></view>
  <view class="muted" wx:if="{{!hospitals.length}}">当前筛选下暂无样例医院。</view>
 </view>
 </block>
 <block wx:if="{{section==='policy'}}">
  <view class="tabpane">
  <view class="card"><view class="heading">政策资讯</view><view class="sub">按地区查看样例政策摘要。真实维护必须标明权威来源、发布日期与生效范围。</view>
   <input placeholder="搜索：标题 / 地区 / 摘要 / 标签" value="{{kwP}}" data-which="kwP" bindinput="inputKw" confirm-type="search"/>
   <view class="muted topgap">共 {{policies.length}} 条{{kwP?'（关键词：'+kwP+'）':''}}</view>
   <view class="row topgap" wx:if="{{kwP}}"><view class="pill" data-which="kwP" bindtap="clearKw">清除「{{kwP}}」</view></view><view class="filter"><view wx:for="{{regions}}" wx:key="*this" class="pill {{activeRegion===item?'active':''}}" data-value="{{item}}" bindtap="pickRegion">{{item}}</view></view></view>
  <view class="card" wx:for="{{policies}}" wx:key="id"><view class="post-title">{{item.title}}</view><view class="muted">{{item.region}} · {{item.publishedAt}} · 来源：{{item.sourceName}}<text class="badge">{{demoNote}}</text></view><view class="sub topgap">{{item.summary}}</view><view class="row topgap"><view class="pill" bindtap="demoOnly">查看原文</view><view class="pill" bindtap="demoOnly">收藏</view></view></view>
  <view class="muted" wx:if="{{!policies.length}}">当前地区下暂无样例政策。</view>
 </view>
 </block>
</view>
